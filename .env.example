# Copy to .env and fill in. All values have safe dev defaults if omitted.

# Port the server listens on
PORT=3000

# Secret used to sign session cookies and encrypt stored provider API keys.
# MUST be set to a long random string in production. Rotating it invalidates
# all sessions and makes previously-stored provider keys unreadable.
APP_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives.
DATABASE_PATH=./data/curio.db

# Set to "true" to allow the app to run without any parent-connected provider
# key by returning canned demo responses (useful for local dev / screenshots).
# When false, a kid session requires the parent to have connected a provider.
DEMO_MODE=true
