# Copy this file to ".env" and edit. The server loads .env automatically.
# All values have safe dev defaults if omitted.

# Port the server listens on
PORT=3000

# Secret used to sign session cookies and encrypt stored provider API keys.
# MUST be a long random string in production. Rotating it logs everyone out and
# makes previously-stored BYO provider keys unreadable.
APP_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives.
DATABASE_PATH=./data/curio.db

# "true" = friendly canned replies when no AI key is available (great for demos).
# Real AI turns on automatically once a key below (or a parent's BYO key) exists.
DEMO_MODE=true

# --- Bundled ("we run the model") mode -------------------------------------
# Set these to have every child use the real model with no per-parent setup.
# CURIO_AI_KEY is an *API* key (from console.anthropic.com or platform.openai.com),
# which is different from a Claude.ai / ChatGPT subscription.
# CURIO_AI_PROVIDER=anthropic
# CURIO_AI_KEY=sk-ant-...
# CURIO_AI_MODEL=claude-sonnet-5

# --- Natural voice (Curio speaks + listens) ---------------------------------
# One OpenAI key powers both: TTS (Curio speaks its replies with a warm, natural
# voice) and STT (the kid's mic audio is transcribed server-side, then discarded
# — never stored). Without a key: robotic browser voice, and the mic only works
# where the browser's own Web Speech API does (desktop Chrome/Edge over https).
# CURIO_TTS_KEY=sk-...                    # an OpenAI API key (platform.openai.com)
# CURIO_TTS_VOICE=nova                    # nova | fable | shimmer | alloy | echo | onyx
# CURIO_TTS_MODEL=gpt-4o-mini-tts         # steerable + natural (tts-1 also works)
# CURIO_TTS_STYLE=                        # optional: override the voice style instructions
# CURIO_STT_MODEL=gpt-4o-mini-transcribe  # mic transcription model
